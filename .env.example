# Set when deploying to a GitHub Pages *project* repo (e.g. username.github.io/portfolio-svelte/).
# Leave empty when deploying to a *user* site (e.g. username.github.io/) or running locally.
# Example: BASE_PATH=/portfolio-svelte
BASE_PATH=

# Substack feed URL — fetched at build time for the /blog page.
# If you don't have a publication yet, leave empty and the blog renders an empty state.
# Example: PUBLIC_SUBSTACK_FEED=https://yourname.substack.com/feed
PUBLIC_SUBSTACK_FEED=
