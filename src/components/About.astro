---
import { siteConfig } from "../config";
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div class="text-center">
    <h2
      class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 dark:text-white"
    >
      About Me
    </h2>
    <div
      class="w-[75px] h-[5px] mt-2 mx-auto rounded-full"
      style={`background-color: ${siteConfig.accentColor}`}
    >
    </div>
  </div>

  <div class="mt-12 max-w-3xl mx-auto text-center">
    <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600 dark:text-gray-400">
      {siteConfig.aboutMe}
    </p>

    <div class="pt-8">
      <div class="flex flex-wrap justify-center gap-3">
        {
          siteConfig.skills.map((skill) => (
            <span class="px-3 sm:px-4 py-1.5 sm:py-2 bg-gray-100 dark:bg-black text-gray-800 dark:text-gray-200 rounded-full text-sm sm:text-base md:text-lg font-medium border border-gray-200 dark:border-gray-700">
              {skill}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
