---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
	hasProjects && (
		<section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
			<div class="text-center">
				<h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 dark:text-white">
					Projects
				</h2>
				<div
					class="w-[75px] h-[5px] mt-2 mx-auto rounded-full"
					style={`background-color: ${siteConfig.accentColor}`}
				/>
			</div>

			<div class="mt-12">
				<div class="space-y-8 max-w-2xl mx-auto">
					{siteConfig.projects.map((project, index) => {
						const hasGithub = project.githubLink;
						const hasMedium = project.mediumLink;
						const hasAnyLink = hasGithub || hasMedium;

						return (
							<div class="relative">
								<div class="block bg-gray-50 dark:bg-black rounded-xl sm:rounded-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
									{project.image && (
										<div class="w-full h-48 sm:h-56 md:h-64 overflow-hidden">
											<img
												src={project.image}
												alt={`${project.name} preview`}
												class="w-full h-full object-contain pt-4 sm:pt-6 md:pt-8"
											/>
										</div>
									)}
									<div class="p-4 sm:p-6 md:p-8 space-y-4 text-center">
										<div>
											<h3 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white mt-1">
												{project.name}
											</h3>
										</div>

										<p class="text-base sm:text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
											{project.description}
										</p>

										{project.skills &&
											project.skills.length > 0 && (
												<div class="flex flex-wrap justify-center gap-3 pt-2">
													{project.skills.map(
														(skill) => (
															<span class="text-sm sm:text-base text-gray-500 dark:text-gray-400">
																# {skill}
															</span>
														),
													)}
												</div>
											)}

										{hasAnyLink && (
											<div class="flex justify-center gap-4 pt-2">
												{hasGithub && (
													<a
														href={
															project.githubLink
														}
														target="_blank"
														rel="noopener noreferrer"
														class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-gray-600 rounded-lg text-white text-base font-bold hover:bg-gray-700 dark:hover:bg-gray-500 transition-colors"
													>
														<svg
															class="w-5 h-5"
															fill="currentColor"
															viewBox="0 0 24 24"
														>
															<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
														</svg>
														Repo
													</a>
												)}
												{hasMedium && (
													<a
														href={
															project.mediumLink
														}
														target="_blank"
														rel="noopener noreferrer"
														class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 dark:bg-gray-600 rounded-lg text-white text-base font-bold hover:bg-gray-700 dark:hover:bg-gray-500 transition-colors"
													>
														<svg
															class="w-5 h-5"
															fill="currentColor"
															viewBox="0 0 24 24"
														>
															<path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z" />
														</svg>
														Article
													</a>
												)}
											</div>
										)}
									</div>
								</div>
							</div>
						);
					})}
				</div>
			</div>
		</section>
	)
}
